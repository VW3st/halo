# Copy to .env and fill in the values you want to use locally.
# .env is ignored by git.

# Provider switches. Leave blank to use halo-config.toml defaults.
HALO_VOICE_PROVIDER=
HALO_ROUTER_PROVIDER=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
HALO_ELEVENLABS_VOICE_ID=
HALO_ELEVENLABS_MODEL=
HALO_ELEVENLABS_OUTPUT_FORMAT=

# OpenRouter Stage 2 router + summarizer
OPENROUTER_API_KEY=
HALO_OPENROUTER_MODEL=
HALO_OPENROUTER_BASE_URL=
HALO_OPENROUTER_APP_NAME=
HALO_OPENROUTER_SITE_URL=

# --- Mic / turn-taking tuning (all optional; blank = balanced defaults) ------
# Talk-over: interrupt Halo mid-reply and it stops + routes what you said.
# ON by default. Set to 0 to disable.
HALO_BARGE_IN_CAPTURE=
# Loudness floor (peak RMS 0..1) a captured interruption must clear so Halo's
# own voice bleeding through the speakers isn't mistaken for you. Default 0.045;
# an echo-cancelling mic auto-relaxes it. Raise if Halo interrupts itself.
HALO_BARGE_IN_MIN_RMS=
# Hot-mic profile: one switch that grabs speech sooner/quieter (more false
# triggers). Set to 1 to enable.
HALO_HOT_MIC=
# Fine-grained sensitivity overrides (win over HALO_HOT_MIC):
HALO_VAD_THRESHOLD=
HALO_SPEECH_RMS_FLOOR=
HALO_ENERGY_ONSET_CHUNKS=
HALO_MIC_NOISE_GATE=

# --- Speech-to-text ----------------------------------------------------------
# Whisper model. Default large-v3-turbo (best accent accuracy at near-distil
# speed); falls back to distil-large-v3 automatically if it can't load.
HALO_STT_MODEL=
# Semantic repair: when Whisper is UNSURE of a transcript, the brain fixes
# mis-recognized words using the conversation context. ON by default; 0 = off.
HALO_STT_REPAIR=
# Only transcripts below this Whisper confidence (avg logprob) are repaired.
# Default -0.5 (confident decodes are ~-0.1..-0.3 and skip repair entirely).
HALO_STT_REPAIR_LOGPROB=
# Wall-clock budget for one repair call before the raw text is used. Default 3.
HALO_STT_REPAIR_TIMEOUT_SEC=

# --- Feature flags (all default ON; set to 0 to disable) ---------------------
# Turn-floor: drop counting/thinking-aloud and let Halo reclaim its turn after a
# promised beat ("give me ten seconds"). The "AI never gets a turn" fix.
HALO_TURN_FLOOR=
# Gap capture: keep listening BETWEEN turns (while Halo routes/replies) and
# feed what you said into the next turn, so nothing lands in dead air.
HALO_GAP_CAPTURE=
# Skill routing: discover Claude/Codex skills and route matching commands to them.
HALO_SKILLS=
# Debug WAV dumps + verbose logs. Defaults ON in a dev checkout, OFF if installed.
HALO_DEBUG=
# Directory for prompt overrides (default ~/.halo/prompts). See `halo prompts`.
HALO_PROMPTS_DIR=
