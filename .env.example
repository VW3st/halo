# Copy to .env and fill in the values you want to use locally.
# .env is ignored by git.

# Provider switches. Leave blank to use halo-config.toml defaults.
HALO_VOICE_PROVIDER=
HALO_ROUTER_PROVIDER=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
HALO_ELEVENLABS_VOICE_ID=
HALO_ELEVENLABS_MODEL=
HALO_ELEVENLABS_OUTPUT_FORMAT=

# OpenRouter Stage 2 router + summarizer (also powers image generation by default)
OPENROUTER_API_KEY=
HALO_OPENROUTER_MODEL=
HALO_OPENROUTER_BASE_URL=
HALO_OPENROUTER_APP_NAME=
HALO_OPENROUTER_SITE_URL=

# Image generation ("generate an image of X").
# DEFAULT provider is "codex" — uses your Codex CLI's built-in image_gen tool
# (gpt-image-2) via your existing `codex login`. NO API key needed (needs
# ChatGPT Plus+). Leave HALO_IMAGE_PROVIDER blank for this.
# Fallbacks: "openrouter" (reuses OPENROUTER_API_KEY above, Google Nano Banana)
# or "openai" (gpt-image-1.5, needs OPENAI_API_KEY).
HALO_IMAGE_PROVIDER=
HALO_IMAGE_MODEL=
HALO_IMAGE_DIR=
OPENAI_API_KEY=
