# Python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.whl

# Virtual envs
.venv/
venv/
env/
ENV/

# Large model artifacts — downloaded per the README, not in source control
models/*.bin
models/*.onnx
models/*.gguf
models/*.safetensors
models/*.pt
models/*.pth
# EXCEPTION: ship the custom-trained halo wake word model (~557 KB).
# Users get a working wake word out of the box without re-training.
!models/halo.onnx
# Local rollback backup files — never commit
models/*.bak
models/*.onnx.bak

# Legacy whisper.cpp binaries (we use faster-whisper now; bin/ kept for fallback)
bin/

# Debug recordings + temp WAVs (DEBUG=True writes them here)
recordings/
*.wav

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts the agents create at project root during voice runs.
# index.html is the real landing page now (since v1.1.1) — keep it tracked.
/halo.html
/hello.py
/*.png
/*.jpg
/*.jpeg
/*.gif

# Environment secrets — never commit
.env
.env.*
!.env.example

# Claude Code's own per-project session state (the dev's own usage,
# not part of Halo's source)
.claude/

# Halo runtime state (project registry, session continuation hashes,
# anything we may persist in the future)
.halo/
~/.halo/

# Logs
*.log
logs/

# Playwright MCP debug snapshots (from browser-driving sessions)
.playwright-mcp/

# Wake-word training sandbox (clone of bbarrick/wakeword_trainer + its venv).
# Self-contained; the only output we keep is models/hey_halo.onnx.
training/
